{
  "name": "signalk-noaa-space-weather",
  "version": "0.30.10",
  "description": "Solar storm alerts, HF radio conditions, and aurora maps from NOAA's Space Weather Prediction Center. Includes a map webapp.",
  "type": "module",
  "displayName": "NOAA Space Weather",
  "appIcon": "/signalk-noaa-space-weather/icon.svg",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prebuild": "node scripts/sync-webapp.mjs && node scripts/sync-icon.mjs",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "watch": "npm run build -- -w",
    "test": "vitest run",
    "demo:build": "node scripts/build-demo.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "node scripts/sync-webapp.mjs && node scripts/sync-icon.mjs",
    "app:build": "node scripts/build-app.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/signalk-noaa-space-weather.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-weather",
    "signalk-webapp",
    "signalk-plugin-configurator"
  ],
  "signalk": {
    "displayName": "NOAA Space Weather",
    "appIcon": "./icon.svg",
    "screenshots": [
      "./docs/screenshots/webapp.png",
      "./docs/screenshots/space-map.png",
      "./docs/screenshots/plugin-configuration.png",
      "./docs/screenshots/data-browser.png",
      "./docs/screenshots/notifications.png"
    ]
  },
  "author": "mark-brannan",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "space-weather": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
