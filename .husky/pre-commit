# Patch-bumps package.json when the staged work ships something and the version
# isn't already past the last release, so nobody has to remember to.
#
# The convenience, not the guarantee: a hook only runs where a hook runs.
# .github/workflows/version-gate.yml is what blocks an unversioned change.

. "$(git rev-parse --show-toplevel)/scripts/publish-impact.sh"

STAGED=$(git diff --cached --name-only --no-renames)
if [ -z "$STAGED" ] || ! echo "$STAGED" | publish_impacting; then
  exit 0
fi

PKG_VERSION=$(node -p "require('./package.json').version")
LATEST_TAG=$(git tag --list 'v*' --sort=-v:refname | head -n1)
LATEST_VERSION="${LATEST_TAG#v}"

if version_is_ahead "$PKG_VERSION" "$LATEST_VERSION"; then
  # Already past the last release -- an explicit, conscious choice by
  # whoever/whatever changed it, however far back on this branch.
  exit 0
fi

NEXT=$(next_patch_version "$PKG_VERSION" "$LATEST_VERSION")
npm version "$NEXT" --no-git-tag-version >/dev/null
git add package.json package-lock.json
echo "Auto-bumped $PKG_VERSION -> $NEXT (nothing staged had given it a version past ${LATEST_TAG:-the first release})"
